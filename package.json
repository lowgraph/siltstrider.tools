    "tailwindcss": "^4.3.3",
    "wrangler": "^4.134.0"
  },
  "dependencies": {
    "@clerk/backend": "^3.18.1",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
